@{
    ViewData["Title"] = "Officer Portal Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card mt-5">
            <div class="card-header text-center py-3">
                <h3 class="font-weight-light my-2">Police Officer Portal</h3>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }
                
                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="form-floating mb-3">
                        <input class="form-control" id="badgeNumber" name="badgeNumber" type="text" placeholder="Enter Official Badge ID" required />
                        <label for="badgeNumber">Official Badge ID</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input class="form-control" id="password" name="password" type="password" placeholder="Enter Secure Password" required />
                        <label for="password">Secure Password</label>
                    </div>
                    <div class="d-grid gap-2 mt-4 mb-0">
                        <button class="btn btn-primary btn-lg fw-bold" type="submit">AUTHENTICATE OFFICER</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>